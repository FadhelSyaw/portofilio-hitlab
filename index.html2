<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portofolio Pribadi</title>
</head>
<body>

    <!-- Header -->
    <header>
        <h1>Fadhel Syauqii Saputro</h1>
        <p>Mahasiswa Sistem Informasi | Future Programmer</p>

        <img src="1000335735.jpg" alt="Foto Profil Fadhel" width="200">
    </header>

    <!-- Navigasi -->
    <nav>
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
    </nav>

    <!-- Konten Utama -->
    <main>

        <!-- About Section -->
        <section id="about">
            <h2>About Me</h2>
            <p>
                Saya merupakan mahasiswa Sistem Informasi yang tertarik
                mempelajari perkembangan teknologi, 
                khususnya dalam bidang pemrograman dan pengembangan aplikasi. 
                Saya ingin terus meningkatkan kemampuan dan pengalaman melalui proses belajar, 
                eksplorasi, serta mencoba membuat berbagai proyek sederhana.
            </p>
        </section>

        <!-- Skills Section -->
        <section id="skills">
            <h2>My Skills</h2>

            <table border="1">
                <tr>
                    <th>No</th>
                    <th>Nama Skill</th>
                    <th>Tingkat Kemahiran</th>
                </tr>

                <tr>
                    <td>1</td>
                    <td>HTML</td>
                    <td>Basic</td>
                </tr>

                <tr>
                    <td>2</td>
                    <td>Python</td>
                    <td>Basic</td>
                </tr>

                <tr>
                    <td>3</td>
                    <td>C++</td>
                    <td>Basic</td>
                </tr>

                <tr>
                    <td>4</td>
                    <td>Microsoft Office</td>
                    <td>Intermediate</td>
                </tr>
            </table>
        </section>

        <!-- Contact Section -->
        <section id="contact">
            <h2>Contact Me</h2>

            <form>
                <label for="nama">Nama:</label>
                <br>
                <input type="text" id="nama" name="nama" required>
                <br><br>

                <label for="email">Email:</label>
                <br>
                <input type="email" id="email" name="email" required>
                <br><br>

                <label for="pesan">Pesan:</label>
                <br>
                <textarea id="pesan" name="pesan" rows="5" cols="30"></textarea>
                <br><br>

                <button type="submit">Submit</button>
            </form>
        </section>

    </main>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 Fadhel Syauqii Saputro</p>
    </footer>

</body>
</html>
